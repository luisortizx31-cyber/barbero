rules_version = '2';

// Multitenant, mismo patrón que control-de-autos (líneas) y
// campeonato-web (colegios):
//   - La plataforma es UNA sola cuenta, fija por su uid (la de Luis):
//     da de alta las barberías y sus cuentas.
//   - Cada barbería es una cuenta real de Firebase Auth, con su perfil
//     en /usuarios marcando a qué barberiaId pertenece: su dueño ve y
//     cambia todo lo suyo, y nada de las demás.
//   - Los barberos y el televisor entran SIN cuenta con el enlace de su
//     barbería (como la controladora en control-de-autos): pueden ver el
//     documento principal (sillas, espera, cortes), los barberos pueden
//     ocupar/liberar sillas y la espera, y anotar el cobro en el
//     historial. Clientes, citas, caja, gastos, etc. son solo del dueño.
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esPlataforma() {
      return estaAutenticado() && request.auth.uid == 'hReh0hAPwCOBqVi9mC81Okx8FiR2';
    }

    function esDuenoDe(barberiaId) {
      return estaAutenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.barberiaId == barberiaId;
    }

    match /usuarios/{uid} {
      allow get: if (estaAutenticado() && request.auth.uid == uid) || esPlataforma();
      allow create, delete: if esPlataforma();
      allow list, update: if false;
    }

    match /barberias/{barberiaId} {
      // Lectura pública: el televisor y los barberos ven las sillas.
      allow read: if true;
      allow create: if esPlataforma() || esDuenoDe(barberiaId);
      allow delete: if esPlataforma();
      // El dueño cambia todo menos la cuenta (correo/uid, eso es de la
      // plataforma); sin cuenta, solo las sillas y la espera.
      allow update: if esPlataforma()
        || (esDuenoDe(barberiaId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'correo']))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sillas', 'espera']);

      // Cada atención: el barbero (sin cuenta) la anota al cobrar.
      match /historial/{id} {
        allow read, update, delete: if esDuenoDe(barberiaId);
        allow create: if esDuenoDe(barberiaId)
          || (request.resource.data.keys().hasAll(['id', 'sillaId', 'inicio', 'fin']) && request.resource.data.id == id);
      }

      // Barberos: se ven en cada silla (foto y nombre), así que su
      // lectura es pública. Se registran solos desde su enlace (sin
      // cuenta) y pueden cambiar su nombre, celular y foto; quitarlos es
      // solo del dueño. La foto va achicada a 30 KB como máximo (con un
      // poco de margen acá).
      match /barberos/{id} {
        function fotoValida() {
          return !('foto' in request.resource.data) || request.resource.data.foto == null
            || (resource != null && request.resource.data.foto == resource.data.get('foto', null))
            || (request.resource.data.foto is string && request.resource.data.foto.size() <= 32000);
        }
        allow read: if true;
        allow create: if esDuenoDe(barberiaId)
          || (request.resource.data.id == id && request.resource.data.nombre is string
              && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 60 && fotoValida());
        allow update: if esDuenoDe(barberiaId)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'telefono', 'foto']) && fotoValida());
        allow delete: if esDuenoDe(barberiaId);
      }

      // Citas: el cliente la reserva desde la página de clientes (sin
      // cuenta) - solo puede CREARLA, pendiente y marcada "web"; verla,
      // cambiarla o borrarla es del dueño (tiene su celular). Lo único
      // que se cambia sin cuenta: el barbero sienta al cliente que llegó
      // con su cita, que pasa de pendiente/aceptada a atendida.
      match /citas/{id} {
        allow read, delete: if esDuenoDe(barberiaId);
        allow update: if esDuenoDe(barberiaId)
          || (resource.data.estado in ['pendiente', 'confirmada'] && request.resource.data.estado == 'atendida'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'atendidaEn', 'sillaId', 'barberoId']));
        allow create: if esDuenoDe(barberiaId)
          || (request.resource.data.id == id && request.resource.data.estado == 'pendiente' && request.resource.data.origen == 'web'
              && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80
              && request.resource.data.fecha is string && request.resource.data.hora is string
              && (request.resource.data.get('clienteId', null) == null || request.resource.data.clienteId is string));
      }

      // Agenda: la parte pública de las citas (día, hora, duración,
      // barbero, silla, nombre corto "Luis O.", su ficha y sus cortes; sin
      // celular), para mostrar las horas libres y que el televisor y los
      // barberos vean de quién es cada cita y lo sienten con ella.
      match /agenda/{id} {
        allow read: if true;
        allow create: if esDuenoDe(barberiaId)
          || (request.resource.data.id == id
              && request.resource.data.keys().hasOnly(['id', 'fecha', 'hora', 'duracion', 'barberoId', 'sillaId', 'confirmada', 'nombre', 'clienteId', 'servicioIds'])
              && request.resource.data.get('confirmada', false) == false);
        allow update, delete: if esDuenoDe(barberiaId);
      }

      // Bloqueos: cada cita toma un carril (uno por silla) y deja un
      // documento por cada 5 minutos que ocupa ("2026-10-20_18:05_2").
      // Sin cuenta solo se pueden CREAR: si ese carril a esa hora ya lo
      // tomó otro, pisarlo sería "update" y no se deja, así que la reserva
      // entera falla. Cuando todas las sillas están tomadas, la hora queda
      // bloqueada. Lectura pública (sin datos de nadie) para ver qué horas
      // quedan.
      match /bloqueos/{id} {
        allow read: if true;
        allow update, delete: if esDuenoDe(barberiaId);
        allow create: if esDuenoDe(barberiaId)
          || (request.resource.data.id == id && request.resource.data.keys().hasOnly(['id', 'citaId', 'carril'])
              && request.resource.data.citaId is string && request.resource.data.carril is int);
      }

      // Fichas: lo público de cada cliente (nombre, 3 últimos números del
      // celular y su huella, corte de siempre) para que se busque en la
      // página de clientes. Las escribe solo el dueño, desde sus clientes.
      // El cliente nuevo puede crear su propia ficha al registrarse (sin
      // visitas, sin tarjeta llena); cambiarla o borrarla es del dueño.
      match /fichas/{id} {
        allow read: if true;
        allow write: if esDuenoDe(barberiaId);
        allow create: if request.resource.data.id == id
          && request.resource.data.keys().hasOnly(['id', 'nombre', 'fin', 'huella', 'servicioIds', 'visitas', 'ultimos', 'citas', 'tarjeta'])
          && request.resource.data.visitas == 0 && request.resource.data.ultimos.size() == 0 && request.resource.data.citas.size() == 0
          && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80;
      }

      // Clientes: el nuevo se registra solo desde la página de clientes
      // (solo crearse, marcado "web", sin notas ni foto). Verlos y
      // cambiarlos sigue siendo del dueño (regla de abajo).
      match /clientes/{id} {
        allow create: if request.resource.data.id == id && request.resource.data.origen == 'web'
          && request.resource.data.keys().hasOnly(['id', 'nombre', 'telefono', 'servicioIds', 'notas', 'fotoCorte', 'origen', 'creadoEn'])
          && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80
          && request.resource.data.telefono is string && request.resource.data.telefono.size() <= 20
          && request.resource.data.notas == '' && request.resource.data.fotoCorte == null && request.resource.data.servicioIds.size() == 0;
      }

      match /{coleccion}/{id} {
        allow read, write: if esDuenoDe(barberiaId)
          && coleccion in ['clientes', 'productos', 'ventas', 'gastos', 'cierres'];
      }
    }

    // Correo y contraseña del dueño, para volver a dárselos: solo la plataforma.
    match /barberias_privado/{barberiaId} {
      allow read, write: if esPlataforma();
    }
  }
}
